<%= render 'layouts/flash' %>

<%= form_with model: [@phone_unit, @warranty] do |f| %>
  <div class="row">
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :warranty_type, t('warranties.type'), class: 'form-label' %>
        <%= f.select :warranty_type,
              Warranty::VALID_TYPES.map { |t| [I18n.t("warranties.types.#{t}"), t] },
              {},
              class: 'form-select' %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :started_at, t('warranties.started_at'), class: 'form-label' %>
        <%= f.date_field :started_at, class: 'form-control' %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :expires_at, t('warranties.expires_at'), class: 'form-label' %>
        <%= f.date_field :expires_at, class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :document_number, t('warranties.document_number'), class: 'form-label' %>
    <%= f.text_field :document_number, class: 'form-control', placeholder: 'NF, contrato...' %>
  </div>

  <div class="mb-3">
    <%= f.label :notes, t('warranties.notes'), class: 'form-label' %>
    <%= f.text_area :notes, class: 'form-control', rows: 3 %>
  </div>

  <div class="mt-3">
    <%= f.submit t('save'), class: 'btn btn-primary' %>
    <%= link_to t('cancel'), phone_unit_warranties_path(@phone_unit), class: 'btn btn-secondary' %>
  </div>
<% end %>
