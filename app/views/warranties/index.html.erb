<div class="section-header">
  <div class="d-flex justify-content-between align-items-center w-100">
    <div>
      <h1><%= t('warranties.title') %></h1>
      <small class="text-muted">IMEI: <code><%= @phone_unit.imei1 %></code> — <%= @phone_unit.product.name %></small>
    </div>
    <div class="d-flex gap-2">
      <%= link_to t('warranties.new'), new_phone_unit_warranty_path(@phone_unit), class: 'btn btn-primary' %>
      <%= link_to t('back'), phone_unit_path(@phone_unit), class: 'btn btn-secondary' %>
    </div>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <%= form_with url: phone_unit_warranties_path(@phone_unit), method: :get, class: 'row g-2 align-items-end' do %>
      <div class="col-md-3">
        <%= select_tag :warranty_type,
              options_for_select(
                [['-- Tipo --', '']] + Warranty::VALID_TYPES.map { |t| [I18n.t("warranties.types.#{t}"), t] },
                params[:warranty_type]
              ),
              class: 'form-select' %>
      </div>
      <div class="col-md-3">
        <%= select_tag :status,
              options_for_select(
                [['-- Status --', ''], [t('warranties.status.active'), 'active'],
                 [t('warranties.status.expiring_soon'), 'expiring_soon'],
                 [t('warranties.status.expired'), 'expired']],
                params[:status]
              ),
              class: 'form-select' %>
      </div>
      <div class="col-auto">
        <%= submit_tag t('search'), class: 'btn btn-outline-secondary' %>
        <%= link_to t('clear'), phone_unit_warranties_path(@phone_unit), class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th><%= t('warranties.type') %></th>
          <th><%= t('warranties.started_at') %></th>
          <th><%= t('warranties.expires_at') %></th>
          <th><%= t('warranties.days_remaining') %></th>
          <th><%= t('warranties.document_number') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @warranties.each do |warranty| %>
          <tr>
            <td><span class="badge bg-primary"><%= t("warranties.types.#{warranty.warranty_type}") %></span></td>
            <td><%= l(warranty.started_at, format: :short) %></td>
            <td><%= l(warranty.expires_at, format: :short) %></td>
            <td>
              <span class="badge <%= warranty_status_badge(warranty.status) %>">
                <%= warranty_days_label(warranty) %>
              </span>
            </td>
            <td><%= warranty.document_number %></td>
            <td class="text-end">
              <%= link_to t('edit'), edit_phone_unit_warranty_path(@phone_unit, warranty), class: 'btn btn-sm btn-outline-primary' %>
              <%= button_to t('delete'), phone_unit_warranty_path(@phone_unit, warranty),
                    method: :delete, class: 'btn btn-sm btn-outline-danger',
                    form: { data: { turbo_confirm: t('warranties.confirm_delete') } } %>
            </td>
          </tr>
        <% end %>
        <% if @warranties.empty? %>
          <tr>
            <td colspan="6" class="text-center text-muted py-4"><%= t('warranties.empty') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
