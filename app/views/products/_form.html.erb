<%= render 'layouts/flash' %>

<%= form_for @product, html: { class: "form-horizontal product", multipart: true, 'data-turbo': 'false' } do |f| %>
  <div class="form-row">
    <div class="form-group col-6">
      <%= f.label :custom_id, t(:custom_id), :class => 'control-label' %>
      <%= f.text_field :custom_id, :class => 'form-control' %>
    </div>
    <div class="form-group col-6">
      <%= f.label :category_id, t(:category_id), :class => 'control-label' %>
      <%= select("product", "category_id", Category.all.collect { |p| [p.name, p.id] }, { include_blank: true }, { class: 'form-control select2-list' }) %>
    </div>
  </div>
  <div class="form-group">
    <%= f.label t(:name), :class => 'control-label' %>
    <%= f.text_field :name, :class => 'form-control' %>
  </div>

  <div class="form-row">
    <div class="form-group col-4">
      <%= f.label :sku, :class => 'control-label' %>
      <%= f.text_field :sku, :class => 'form-control' %>
    </div>
    <div class="form-group col-4">
      <%= f.label :extra_sku, :class => 'control-label' %>
      <%= f.text_field :extra_sku, :class => 'form-control' %>
    </div>
    <div class="form-group col-4">
      <%= f.label t(:price), :class => 'control-label' %>
      <%= f.text_field :price, :class => 'form-control' %>
    </div>
  </div>

  <div class="form-group">
    <div class="custom-file">
      <%= f.file_field :image, class: 'custom-file-input' %>
      <%= f.label t('products.image'), :class => 'custom-file-label' %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-3">
      <div class="custom-control custom-checkbox">
        <%= f.check_box :highlight, class: 'custom-control-input' %>
        <%= f.label :highlight, class: 'custom-control-label font-weight-bold' %>
      </div>
    </div>
    <div class="form-group col-3">
      <div class="custom-control custom-checkbox">
        <%= f.check_box :active, class: 'custom-control-input' %>
        <%= f.label :active, t(:active), class: 'custom-control-label font-weight-bold' %>
      </div>
    </div>
  </div>

  <hr/>
  <h5 class="mb-3"><%= t('products.celular.section_title') %></h5>

  <div class="form-row">
    <div class="form-group col-6">
      <%= f.label :brand, t('products.celular.brand'), class: 'control-label' %>
      <%= f.text_field :brand, class: 'form-control', placeholder: 'ex: Samsung, Apple, Motorola' %>
    </div>
    <div class="form-group col-6">
      <%= f.label :model_name, t('products.celular.model_name'), class: 'control-label' %>
      <%= f.text_field :model_name, class: 'form-control', placeholder: 'ex: Galaxy S23, iPhone 15 Pro' %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-4">
      <%= f.label :imei1, t('products.celular.imei1'), class: 'control-label' %>
      <%= f.text_field :imei1, class: 'form-control', placeholder: '15 dígitos', maxlength: 15, inputmode: 'numeric' %>
    </div>
    <div class="form-group col-4">
      <%= f.label :imei2, t('products.celular.imei2'), class: 'control-label' %>
      <%= f.text_field :imei2, class: 'form-control', placeholder: '15 dígitos (dual SIM)', maxlength: 15, inputmode: 'numeric' %>
    </div>
    <div class="form-group col-4">
      <%= f.label :serial_number, t('products.celular.serial_number'), class: 'control-label' %>
      <%= f.text_field :serial_number, class: 'form-control', placeholder: 'Número de série' %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-3">
      <%= f.label :storage_gb, t('products.celular.storage_gb'), class: 'control-label' %>
      <%= f.select :storage_gb,
            options_for_select([['-', nil], ['16 GB', 16], ['32 GB', 32], ['64 GB', 64],
                                ['128 GB', 128], ['256 GB', 256], ['512 GB', 512], ['1 TB', 1024]],
                               @product.storage_gb),
            {}, class: 'form-control' %>
    </div>
    <div class="form-group col-3">
      <%= f.label :ram_gb, t('products.celular.ram_gb'), class: 'control-label' %>
      <%= f.select :ram_gb,
            options_for_select([['-', nil], ['1 GB', 1], ['2 GB', 2], ['3 GB', 3], ['4 GB', 4],
                                ['6 GB', 6], ['8 GB', 8], ['12 GB', 12], ['16 GB', 16]],
                               @product.ram_gb),
            {}, class: 'form-control' %>
    </div>
    <div class="form-group col-3">
      <%= f.label :color, t('products.celular.color'), class: 'control-label' %>
      <%= f.text_field :color, class: 'form-control', placeholder: 'ex: Preto, Branco, Azul' %>
    </div>
    <div class="form-group col-3">
      <%= f.label :battery_health, t('products.celular.battery_health'), class: 'control-label' %>
      <%= f.number_field :battery_health, class: 'form-control', min: 1, max: 100, placeholder: '%' %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-6">
      <%= f.label :condition, t('products.celular.condition'), class: 'control-label' %>
      <%= f.select :condition,
            options_for_select(Product::VALID_CONDITIONS.map { |c| [t("products.celular.conditions.#{c}"), c] },
                               @product.condition),
            { include_blank: t('products.celular.select_condition') },
            class: 'form-control' %>
    </div>
  </div>

  <hr/>

  <div class="form-group">
    <%= f.submit t('save'), :class => 'btn btn-primary' %>
    <%= link_to t('.cancel', :default => t("helpers.links.cancel")),
                products_path, :class => 'btn btn-default' %>
  </div>

  <div class="form-group">
    <%= f.label :number_of_pieces_per_fabric_roll %>
    <%= f.number_field :number_of_pieces_per_fabric_roll, class: 'form-control' %>
  </div>

<% end %>
