<div class="row g-2 mb-2 service-order-item">
  <%= f.hidden_field :id %>
  <div class="col-md-4">
    <%= f.text_field :description, class: 'form-control form-control-sm', placeholder: 'Descrição da peça / serviço' %>
  </div>
  <div class="col-md-3">
    <%= f.select :product_id,
          Product.where(account_id: current_tenant).order(:name).map { |p| [p.name, p.id] },
          { include_blank: 'Peça do estoque (opcional)' },
          class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-1">
    <%= f.number_field :quantity, class: 'form-control form-control-sm', min: 1, placeholder: 'Qtd', value: (f.object.quantity || 1) %>
  </div>
  <div class="col-md-2">
    <%= f.number_field :unit_price, class: 'form-control form-control-sm', step: 0.01, min: 0, placeholder: 'R$ unitário' %>
  </div>
  <div class="col-md-1 d-flex align-items-center">
    <%= f.check_box :_destroy, class: 'd-none', id: "destroy_#{f.object.object_id}" %>
    <%= label_tag "destroy_#{f.object.object_id}", '✕',
          class: 'btn btn-sm btn-outline-danger',
          onclick: "this.previousElementSibling.value='1'; this.closest('.service-order-item').style.opacity='0.4'" %>
  </div>
</div>
