<%= render 'layouts/flash' %>

<%= form_with model: @phone_unit, class: 'form-horizontal' do |f| %>
  <div class="row">
    <div class="col-md-6">
      <div class="mb-3">
        <%= f.label :product_id, t('phone_units.product'), class: 'form-label' %>
        <%= f.select :product_id,
              Product.where(account_id: current_tenant).order(:name).map { |p| [p.name, p.id] },
              { include_blank: t('phone_units.select_product') },
              class: 'form-select select2-list' %>
      </div>
    </div>
    <div class="col-md-3">
      <div class="mb-3">
        <%= f.label :status, t('phone_units.status'), class: 'form-label' %>
        <%= f.select :status,
              PhoneUnit::VALID_STATUSES.map { |s| [t("phone_units.statuses.#{s}"), s] },
              {},
              class: 'form-select' %>
      </div>
    </div>
    <div class="col-md-3">
      <div class="mb-3">
        <%= f.label :condition, t('phone_units.condition'), class: 'form-label' %>
        <%= f.select :condition,
              PhoneUnit::VALID_CONDITIONS.map { |c| [t("phone_units.conditions.#{c}"), c] },
              { include_blank: '-- Selecione --' },
              class: 'form-select' %>
      </div>
    </div>
  </div>

  <hr/>
  <h6 class="text-muted mb-3"><%= t('phone_units.identification_section') %></h6>

  <div class="row">
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :imei1, 'IMEI 1', class: 'form-label' %>
        <span class="text-danger">*</span>
        <%= f.text_field :imei1, class: 'form-control', placeholder: '15 dígitos', maxlength: 15, inputmode: 'numeric' %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :imei2, 'IMEI 2 (Dual SIM)', class: 'form-label' %>
        <%= f.text_field :imei2, class: 'form-control', placeholder: '15 dígitos', maxlength: 15, inputmode: 'numeric' %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :serial_number, t('phone_units.serial_number'), class: 'form-label' %>
        <%= f.text_field :serial_number, class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3">
      <div class="mb-3">
        <%= f.label :color, t('phone_units.color'), class: 'form-label' %>
        <%= f.text_field :color, class: 'form-control', placeholder: 'ex: Preto' %>
      </div>
    </div>
    <div class="col-md-3">
      <div class="mb-3">
        <%= f.label :battery_health, t('phone_units.battery_health'), class: 'form-label' %>
        <%= f.number_field :battery_health, class: 'form-control', min: 1, max: 100, placeholder: '%' %>
      </div>
    </div>
    <div class="col-md-3">
      <div class="mb-3">
        <%= f.label :purchase_price, t('phone_units.purchase_price'), class: 'form-label' %>
        <%= f.number_field :purchase_price, class: 'form-control', step: 0.01, min: 0 %>
      </div>
    </div>
    <div class="col-md-3">
      <div class="mb-3">
        <%= f.label :sale_price, t('phone_units.sale_price'), class: 'form-label' %>
        <%= f.number_field :sale_price, class: 'form-control', step: 0.01, min: 0 %>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :notes, t('phone_units.notes'), class: 'form-label' %>
    <%= f.text_area :notes, class: 'form-control', rows: 3 %>
  </div>

  <div class="mt-3">
    <%= f.submit t('save'), class: 'btn btn-primary' %>
    <%= link_to t('cancel'), phone_units_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
