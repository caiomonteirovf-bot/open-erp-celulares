<div class="section-header">
  <div class="d-flex justify-content-between align-items-center w-100">
    <h1><%= t('phone_units.title') %></h1>
    <%= link_to t('phone_units.new'), new_phone_unit_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <%= form_with url: phone_units_path, method: :get, class: 'row g-2 align-items-end' do %>
      <div class="col-md-3">
        <%= text_field_tag :imei, params[:imei], class: 'form-control', placeholder: t('phone_units.search_imei') %>
      </div>
      <div class="col-md-3">
        <%= text_field_tag :search, params[:search], class: 'form-control', placeholder: t('phone_units.search_product') %>
      </div>
      <div class="col-md-2">
        <%= select_tag :status,
              options_for_select(
                [['-- Status --', '']] + PhoneUnit::VALID_STATUSES.map { |s| [t("phone_units.statuses.#{s}"), s] },
                params[:status]
              ),
              class: 'form-select' %>
      </div>
      <div class="col-auto">
        <%= submit_tag t('search'), class: 'btn btn-outline-secondary' %>
        <%= link_to t('clear'), phone_units_path, class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>IMEI 1</th>
          <th><%= t('phone_units.product') %></th>
          <th><%= t('phone_units.condition') %></th>
          <th><%= t('phone_units.battery_health') %></th>
          <th><%= t('phone_units.status') %></th>
          <th><%= t('phone_units.purchase_price') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @phone_units.each do |unit| %>
          <tr>
            <td><code><%= unit.imei1 %></code></td>
            <td><%= unit.product.name %></td>
            <td><%= t("phone_units.conditions.#{unit.condition}") if unit.condition.present? %></td>
            <td><%= "#{unit.battery_health}%" if unit.battery_health.present? %></td>
            <td>
              <span class="badge <%= status_badge_class(unit.status) %>">
                <%= t("phone_units.statuses.#{unit.status}") %>
              </span>
            </td>
            <td><%= number_to_currency(unit.purchase_price, unit: 'R$') if unit.purchase_price.present? %></td>
            <td class="text-end">
              <%= link_to t('show'), phone_unit_path(unit), class: 'btn btn-sm btn-outline-secondary' %>
              <%= link_to t('edit'), edit_phone_unit_path(unit), class: 'btn btn-sm btn-outline-primary' %>
            </td>
          </tr>
        <% end %>
        <% if @phone_units.empty? %>
          <tr>
            <td colspan="7" class="text-center text-muted py-4">
              <%= t('phone_units.empty') %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%= render 'shared/pagy_nav', pagy: @pagy if @pagy %>
